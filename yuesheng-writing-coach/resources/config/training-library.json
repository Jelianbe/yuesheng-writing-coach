    {
      "id": "TRAIN-P004-003",
      "syndromeId": "P004",
      "syndromeName": "信息硬塞",
      "title": "信息分层释放",
      "difficulty": "medium",
      "mode": "restructure",
      "tier": "structural",
      "constraint": "你有一段300字的世界观/角色设定信息。规则：将这些信息按'读者必须现在知道'和'读者可以稍后知道'分为两层。第一层（必须现在）最多保留3个信息点（每个不超过20字）。第二层分布到后面3个不同的章节情节点中释放，每个点只释放一个信息，且必须与当前情节产生化学反应——不是生硬插入而是'这里正好提到'。写出原始段落、精炼后的段落、以及3个释放点的场景设计。",
      "expectedOutcome": "用户建立'信息分层意识'，能区分读者何时需要知道某条信息并为其设计自然的释放时机",
      "techniques": [
        "T105",
        "T096"
      ],
      "exercises": [
        {
          "step": 1,
          "instruction": "取一段300字设定，逐句标注：这句信息对理解当前情节是必要/重要/可选？",
          "duration": "5min"
        },
        {
          "step": 2,
          "instruction": "保留'必要'信息（最多3条，每条≤20字），其他全部从当前段删除",
          "duration": "8min"
        },
        {
          "step": 3,
          "instruction": "为每条被删除的信息，找一个未来3章内的情节点——在该情节点中，这条信息的出现能推动情节、制造阻碍或揭示人物",
          "duration": "10min"
        },
        {
          "step": 4,
          "instruction": "为每个释放点写一个50-100字的嵌入场景，确保信息不是被'说'出来的而是在情节中被'遇'到的",
          "duration": "10min"
        }
      ],
      "developmentStage": "structure",
      "classicalBasis": [
        {
          "principleId": "CHEKHOV_GUN"
        },
        {
          "principleId": "STRUNK_WHITE_CONCISE"
        }
      ]
    },
