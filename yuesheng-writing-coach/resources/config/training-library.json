      "syndromeName": "情绪标签化",
      "title": "五感情绪锚",
      "difficulty": "easy",
      "mode": "narrow_focus",
      "tier": "surface",
      "constraint": "选择一种情绪（愤怒/悲伤/恐惧/喜悦），用一段200字的场景描写展示它。规则：全文禁止出现该情绪词本身及其近义词（如写'愤怒'则禁止出现'生气''恼火''愤怒''怒'等），只能通过动作、环境、身体反应和对话节奏来传达。",
      "expectedOutcome": "用户学会用感官细节替代情绪标签词，建立'展示而非告知'的写作习惯",
      "techniques": [
        "T063",
        "T016",
        "T026"
      ],
      "exercises": [
        {
          "step": 1,
          "instruction": "选定一个情绪词，写出它的5个身体反应（如愤怒→紧握拳头/呼吸变浅/耳鸣/下颚收紧/视野变窄）",
          "duration": "5min"
        },
        {
          "step": 2,
          "instruction": "设计一个日常场景（等公交/做饭/接电话），让角色在这个场景中体验你选的情绪",
          "duration": "5min"
        },
        {
          "step": 3,
          "instruction": "写出200字段落，只用动作+环境+身体反应+对话节奏来表达，逐句检查是否出现了情绪词",
          "duration": "15min"
        },
        {
          "step": 4,
          "instruction": "找一个人读你的文字，问他感受到什么情绪。如果不对，调整细节直到匹配",
          "duration": "5min"
        }
      ],
      "developmentStage": "word",
      "classicalBasis": [
        {
          "principleId": "WANG_ZENG_QI_ACCURACY"
        },
