{
  "name": "yuesheng-writing-coach",
  "version": "1.4.0",
  "description": "月笙写作教练 - AI 驱动的写作辅导工具",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:tsc": "tsc -w",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "predev:electron": "npm run rebuild:electron",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:main": "tsc",
    "prebuild": "npm run rebuild:electron",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "prestart": "npm run rebuild:electron",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings 400",
    "lint:css": "stylelint \"src/**/*.css\" --config .stylelintrc.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "scan:hardcode": "npx tsx scripts/check-a11y-colors.ts",
    "check:size": "npx tsx scripts/check-file-size.ts",
    "check:audit": "npm audit --audit-level=high",
    "check:bundle": "vite-bundle-visualizer",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "check:id": "node scripts/check-id-naming.mjs",
    "test": "vitest run",
    "pretest": "npm run rebuild:node",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:firefox-mobile": "playwright test --project=firefox-mobile",
    "test:e2e:verbose": "cross-env PWVERBOSE=1 playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual --update-snapshots",
    "test:visual:check": "playwright test --grep @visual",
    "test:report": "playwright show-report",
    "precommit": "npm run sync:ipc && npm run typecheck && npm run test",
    "ci": "npm run sync:ipc && npm run typecheck && npm run test && npm run scan:hardcode && npm run build",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 400",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --config .stylelintrc.json --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "better-sqlite3": "^12.11.1",
    "electron-store": "^8.1.0",
    "lucide-react": "^1.17.0",
    "react-arborist": "^3.10.5",
    "react-intl": "^10.1.14",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^10.0.1",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "madge": "^8.0.0",
    "node-gyp": "^12.3.0",
    "prettier": "^3.9.4",
    "prompt-builder-skill": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.16",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.5",
    "storybook": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "playwright": "^1.61.1",
    "@vitest/browser-playwright": "^4.1.7"
  }
}
