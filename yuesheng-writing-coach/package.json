{
  "name": "yuesheng-writing-coach",
  "version": "1.0.0",
  "description": "月笙写作教练 - AI 驱动的写作辅导工具",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:tsc": "tsc -w",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:main": "tsc",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings 300",
    "scan:hardcode": "npx tsx scripts/check-a11y-colors.ts",
    "check:size": "npx tsx scripts/check-file-size.ts",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "check:id": "node scripts/check-id-naming.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "precommit": "npm run typecheck && npm run test",
    "ci": "npm run typecheck && npm run test && npm run scan:hardcode && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-store": "^8.1.0",
    "lucide-react": "^1.17.0",
    "react-arborist": "^3.10.5",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.1",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "madge": "^8.0.0",
    "node-gyp": "^12.3.0",
    "postcss": "^8.5.15",
    "prompt-builder-skill": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.5"
  }
}
