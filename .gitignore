# 忽略项目外所有内容
/*
!.trae/
!.vscode/
!.gitignore
!yuesheng-writing-coach/

# 项目内忽略规则
**/node_modules/
**/dist/
**/.cache/
**/*.tsbuildinfo
**/coverage/
**/.env
**/.env.local
**/.env.*.local

# IDE
**/.idea/
**/.vscode/settings.json
**/.vscode/*.code-workspace

# OS
**/.DS_Store
**/Thumbs.db

# Logs
**/*.log

# Electron 打包产物
**/release/
**/build/

# 临时文件
**/*.tmp
**/*.bak
