#!/usr/bin/env bash
# ============================================================================
# 月笙写作教练 — git pre-commit hook（快道拦截）
#
# 行为：
#   - 仅当本次 staged 变更触及 yuesheng-flutter/ 或 flutter_ci.yaml 时运行
#   - 跑的是**快道** scripts/gate-fast.sh（约 40 秒），**不是**收尾十九道
#     ⇒ 门禁 6（覆盖率）不在快道内；声称「完成」前仍须手工跑 gate.sh
#   - 若本地缺 dart/flutter 工具链，警告但不阻断（CI 仍会事后拦截）
#   - 紧急跳过：    SKIP_GIT_GATE=1 git commit ...
#
# ★ 为什么调快道而不是全量 gate.sh（2026-09-17 口径收口）：
#   本 hook 的历史版本直接调 `bash scripts/gate.sh`（十二道全量，约 4~6 分钟），
#   文案也写着「五道门禁」。但实测：`.git/hooks/` 里**一个 hook 都没装**
#   （全是 `.sample`）、`core.hooksPath` 未设、安装脚本自身还有一个拼写 bug
#   （见 install-git-hooks.ps1）。让「每次提交」等 4.5 分钟的设计方向是反的——
#   难怪它从未被装上。**快的才可能被人接受**，所以这里换成约 40 秒的快道。
#
#   代价必须讲清：快道**不覆盖**门禁 6（覆盖率），且门禁 2 只跑受影响的测试。
#   它拦截的是「格式/类型/循环依赖/密钥/函数行数/prompt/元数据/交互/伪拆分/
#   A 类豁免」这十道 + 窄范围回归，**不等于**收尾全绿。
#
# 安装：        pwsh yuesheng-flutter/scripts/install-git-hooks.ps1
# 卸载：        rm .git/hooks/pre-commit
# ============================================================================
set -u

# -------- 绕过开关 --------
if [ "${SKIP_GIT_GATE:-0}" = "1" ]; then
  echo "[pre-commit] ⚙  SKIP_GIT_GATE=1，已跳过本地快道（CI 仍会在 push 后拦截）"
  exit 0
fi

# -------- 仓库根定位 --------
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  echo "[pre-commit] ⚠  无法定位 git 仓库根，跳过本地快道"
  exit 0
fi

# -------- 范围判定：是否涉及 Flutter 子目录 / CI workflow --------
staged="$(git diff --cached --name-only)"
hit=0
if printf '%s\n' "$staged" | grep -qE '^yuesheng-flutter/'; then
  hit=1
fi
if printf '%s\n' "$staged" | grep -qE '^\.github/workflows/flutter_ci\.yaml$'; then
  hit=1
fi

# 【2026-10-20 并入仓内源】本段此前**只存在于 .git/hooks/pre-commit**（生效副本），
#   未回写本文件。门禁 16（hook 副本同步）抓到 md5 不一致才暴露 —— 而它当时给出的
#   修复建议是「重装副本」，照做会把这 45 行静默覆盖丢失。现已并入真源，副本由
#   install-git-hooks.ps1 生成。**改 hook 一律改本文件，不要改 .git/hooks/ 下的副本。**

# -------- eval 闸自检（W-43 · 仅当改动 tool/eval/ 时，约 1 秒）--------
# 为什么放在快道之前：闸的价值是「廉价假设不必付生产代价」⇒ 它本身必须便宜
#   （1 秒 vs 快道 40 秒 vs 全量 4~6 分钟）。快的才可能一直开着。
# 拦什么：只拦「改了闸代码却没验证」—— 重跑闸并要求 reportable_variants 与上一条产物
#   一致；变了就说明改动影响了判定或口径，必须显式确认，不能被当成普通重构提交。
# 不拦什么：普通 lib/ 改动（闸只吃 trace，与实现无关）；缺 trace 的新克隆机（跳过并提示）。
# ★ 已知局限（不要误以为已覆盖）：判据正文在 `.ai` 独立仓
#   （.ai/reports/eval_gate.md / eval_gate.criteria.json），本钩子装在父仓，
#   `git diff --cached` 看不到 `.ai` 的 staged ⇒ **改判据不会触发本段**，须手工跑闸。
EVAL_FLUTTER="$REPO_ROOT/yuesheng-flutter"
if printf '%s\n' "$staged" | grep -qE '^yuesheng-flutter/tool/eval/'; then
  EVAL_TRACE="$EVAL_FLUTTER/outputs/gate/eval_trace.jsonl"
  EVAL_OUT="$EVAL_FLUTTER/outputs/gate/promotion_gate.json"
  if [ ! -f "$EVAL_TRACE" ]; then
    echo "[pre-commit] ⚠  检测到 tool/eval/ 变更，但缺 trace（outputs 不入仓）⇒ 跳过闸自检"
    echo "             重建：cd yuesheng-flutter && flutter test tool/eval/eval_runner.dart"
  elif command -v dart >/dev/null 2>&1 && command -v python >/dev/null 2>&1; then
    echo "[pre-commit] 🧪 tool/eval/ 有变更 ⇒ 跑 eval 闸自检（约 1 秒）..."
    GATE_TMP="$(mktemp)"
    PREV_LIST=""
    if [ -f "$EVAL_OUT" ]; then
      PREV_LIST="$(python -c "import json,sys;print(','.join(json.load(open(sys.argv[1],encoding='utf-8'))['reportable_variants']))" "$EVAL_OUT" 2>/dev/null || true)"
    fi
    if ( cd "$EVAL_FLUTTER" && dart run tool/eval/promotion_gate.dart ) >"$GATE_TMP" 2>&1; then
      NEW_LIST="$(python -c "import json,sys;print(','.join(json.load(open(sys.argv[1],encoding='utf-8'))['reportable_variants']))" "$EVAL_OUT" 2>/dev/null || true)"
      if [ -n "$PREV_LIST" ] && [ "$PREV_LIST" != "$NEW_LIST" ]; then
        echo "[pre-commit] ❌ 闸自检：可提报变体变了（$PREV_LIST → $NEW_LIST）"
        echo "             这不是形式问题 —— 说明本次改动动了判定或口径。"
        echo "             确认是有意的：重跑闸并一并提交新产物；否则回退改动。"
        rm -f "$GATE_TMP"
        exit 1
      fi
      echo "[pre-commit] ✅ 闸自检通过（可提报 = ${NEW_LIST:-?}，与上一条一致）"
    else
      echo "[pre-commit] ❌ 闸自检失败（闸本身 exit≠0）："
      tail -20 "$GATE_TMP"
      rm -f "$GATE_TMP"
      exit 1
    fi
    rm -f "$GATE_TMP"
  else
    echo "[pre-commit] ⚠  缺 dart 或 python，跳过 eval 闸自检（不阻断）"
  fi
fi

if [ "$hit" -eq 0 ]; then
  # 本次改动不涉及 Flutter，快道跳过（省一次无谓等待）
  echo "[pre-commit] ⏭  未触及 yuesheng-flutter/ 或 flutter_ci.yaml，跳过快道"
  exit 0
fi

echo ""
echo "======================================================================"
echo "[pre-commit] 🚦 检测到 Flutter / CI 变更，触发本地快道门禁..."
echo "              （约 40 秒；紧急提交用 SKIP_GIT_GATE=1 跳过）"
echo "              ⚠️ 快道不含门禁 6（覆盖率）—— 收尾请跑 scripts/gate.sh"
echo "======================================================================"

# -------- 工具存在性自检 --------
missing=0
for tool in dart flutter; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "[pre-commit] ⚠  未在 PATH 中找到 $tool（需要 Flutter SDK）"
    missing=1
  fi
done

if [ "$missing" -eq 1 ]; then
  echo ""
  echo "[pre-commit] ⚠  本地 Flutter 工具链缺失，快道不做阻断拦截。"
  echo "              请在 PATH 中加入 Flutter/bin，或依赖 push 后 CI 拦截。"
  echo "              安装指引：https://docs.flutter.dev/get-started/install"
  exit 0
fi

# -------- 执行快道 --------
FLUTTER_DIR="$REPO_ROOT/yuesheng-flutter"
if [ ! -f "$FLUTTER_DIR/scripts/gate-fast.sh" ]; then
  echo "[pre-commit] ❌ 找不到快道脚本：$FLUTTER_DIR/scripts/gate-fast.sh"
  echo "              （若该脚本尚未落地，可临时改回 bash scripts/gate.sh）"
  exit 1
fi

cd "$FLUTTER_DIR" || exit 1
if bash scripts/gate-fast.sh; then
  echo ""
  echo "[pre-commit] ✅ 快道门禁通过，允许提交"
  echo "[pre-commit] ⚠️  提醒：这不是收尾全绿。声称「完成」前须跑"
  echo "[pre-commit]     cd yuesheng-flutter && bash scripts/gate.sh（十九道）"
  exit 0
else
  echo ""
  echo "======================================================================"
  echo "[pre-commit] ❌ 快道门禁未通过，提交被拦截。"
  echo ""
  echo "  👉 请修复上方 FAIL 的门禁后再次提交；"
  echo "     或查看 yuesheng-flutter/outputs/gate-fast/gate-report.md 获取报告。"
  echo ""
  echo "  👉 紧急提交（仍会被 CI 事后拦截）："
  echo "     SKIP_GIT_GATE=1 git commit ..."
  echo "======================================================================"
  exit 1
fi
