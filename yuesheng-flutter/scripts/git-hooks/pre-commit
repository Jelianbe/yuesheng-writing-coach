#!/usr/bin/env bash
# ============================================================================
# 月笙写作教练 — git pre-commit hook（四道门禁本地拦截）
#
# 行为：
#   - 仅当本次 staged 变更触及 yuesheng-flutter/ 或 flutter_ci.yaml 时运行四闸
#   - 若本地缺 dart/flutter 工具链，警告但不阻断（CI 仍会事后拦截）
#   - 紧急跳过：    SKIP_GIT_GATE=1 git commit ...
#
# 安装：        pwsh yuesheng-flutter/scripts/install-git-hooks.ps1
# 卸载：        rm .git/hooks/pre-commit
# ============================================================================
set -u

# -------- 绕过开关 --------
if [ "${SKIP_GIT_GATE:-0}" = "1" ]; then
  echo "[pre-commit] ⚙  SKIP_GIT_GATE=1，已跳过本地四闸（CI 仍会在 push 后拦截）"
  exit 0
fi

# -------- 仓库根定位 --------
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  echo "[pre-commit] ⚠  无法定位 git 仓库根，跳过四闸"
  exit 0
fi

# -------- 范围判定：是否涉及 Flutter 子目录 / CI workflow --------
staged="$(git diff --cached --name-only)"
hit=0
if printf '%s\n' "$staged" | grep -qE '^yuesheng-flutter/'; then
  hit=1
fi
if printf '%s\n' "$staged" | grep -qE '^\.github/workflows/flutter_ci\.yaml$'; then
  hit=1
fi

if [ "$hit" -eq 0 ]; then
  # 本次改动不涉及 Flutter，四闸跳过（节省 ~5 分钟等待）
  echo "[pre-commit] ⏭  未触及 yuesheng-flutter/ 或 flutter_ci.yaml，跳过四闸"
  exit 0
fi

echo ""
echo "======================================================================"
echo "[pre-commit] 🚦 检测到 Flutter / CI 变更，触发本地四道门禁..."
echo "              （耗时约 4~6 分钟；紧急提交用 SKIP_GIT_GATE=1 跳过）"
echo "======================================================================"

# -------- 工具存在性自检 --------
missing=0
for tool in dart flutter; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "[pre-commit] ⚠  未在 PATH 中找到 $tool（需要 Flutter SDK）"
    missing=1
  fi
done

if [ "$missing" -eq 1 ]; then
  echo ""
  echo "[pre-commit] ⚠  本地 Flutter 工具链缺失，四闸不做阻断拦截。"
  echo "              请在 PATH 中加入 Flutter/bin，或依赖 push 后 CI 拦截。"
  echo "              安装指引：https://docs.flutter.dev/get-started/install"
  exit 0
fi

# -------- 执行四闸 --------
FLUTTER_DIR="$REPO_ROOT/yuesheng-flutter"
if [ ! -f "$FLUTTER_DIR/scripts/gate.sh" ]; then
  echo "[pre-commit] ❌ 找不到 gate.sh：$FLUTTER_DIR/scripts/gate.sh"
  exit 1
fi

cd "$FLUTTER_DIR" || exit 1
if bash scripts/gate.sh; then
  echo ""
  echo "[pre-commit] ✅ 四道门禁全部通过，允许提交"
  exit 0
else
  echo ""
  echo "======================================================================"
  echo "[pre-commit] ❌ 四道门禁未通过，提交被拦截。"
  echo ""
  echo "  👉 请修复上方 FAIL 的门禁后再次提交；"
  echo "     或查看 yuesheng-flutter/outputs/gate/gate-report.md 获取报告。"
  echo ""
  echo "  👉 紧急提交（仍会被 CI 事后拦截）："
  echo "     SKIP_GIT_GATE=1 git commit ..."
  echo "======================================================================"
  exit 1
fi
